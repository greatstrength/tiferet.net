<Project>

  <PropertyGroup>
    <Authors>greatstrength</Authors>
    <Company>greatstrength</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/greatstrength/tiferet.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/greatstrength/tiferet.net</PackageProjectUrl>
    <Version>1.0.0-beta.8</Version>
    <!-- Default: nothing is packable. src/ projects opt in by overriding to true. -->
    <IsPackable>false</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
